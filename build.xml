<?xml version="1.0" ?>
<project name="jars" default="make_dotnet_msbuild">

	<property name="message" value="Building proparse..."/>
	<property name="core_xclds" value="**/*.g,**/*.smap,**/*.SF,**/*.launch,**/*.testsuite,**/*.deploy,**/*.location,**/*.execution,**/*.datapool,**/*.artifact,**/*.html,**/*.svg,**/*.groovy,Release/**" />
	<property name="output.dir" value="${basedir}\output"/>
	<property name="output.dir.x64" value="${output.dir}\x64"/>
	<property name="output.dir.x86" value="${output.dir}\x86"/>
	<property name="output.dir.netcore" value="${output.dir}\netcore"/>
	<property name="package.zip.win-x64" value="${output.dir}\proparse.win-x64.zip"/>
	<property name="package.zip.win-x86" value="${output.dir}\proparse.win-x86.zip"/>
	<property name="package.zip.netcore" value="${output.dir}\proparse.netcore-linux-x64.zip"/>
	<property name="output.dir.netcore.win" value="${output.dir}\netcore-win-x64"/>
	<property name="package.zip.netcore.win" value="${output.dir}\proparse.netcore-win-x64.zip"/>
	<property name="package.zip.java" value="${output.dir}\proparse.java.zip"/>
	<property name="ikvm.bin.dir" value="${basedir}\ikvmbin"/>
	<property name="src.dir" value="${basedir}/src"/>
	<property name="bin.dir" value="${basedir}/bin"/>
	<!-- Java bytecode level. IKVM 8.x is based on OpenJDK 8, so keep this at 8 even when compiling with a newer JDK. -->
	<property name="java.release" value="8"/>

	<path id="build-classpath">
		<fileset dir="lib">
			<include name="*.jar"/>
		</fileset>
	</path>

	<macrodef name="msbuild">
		<attribute name="version" default="${build.number}"/>
		<attribute name="output" default="${output.dir}"/>
		<!--https://github.com/ikvmnet/ikvm?tab=readme-ov-file#support-->
		<!--https://learn.microsoft.com/en-us/dotnet/standard/frameworks-->
		<attribute name="targetVersion" default="net472"/>
		<!--https://learn.microsoft.com/en-us/dotnet/core/rid-catalog-->
		<attribute name="runtime" default="any"/>
		<!--q[uiet], m[inimal], n[ormal] (default), d[etailed], and diag[nostic]-->
		<attribute name="verbose" default="n"/>
		<attribute name="baseDir" default="${basedir}"/>
		<attribute name="IkvmVersion" default="8.15.0"/>
		<attribute name="dllFileName" default="proparse.net"/>
		<attribute name="copyDependencies" default="true"/>
		<attribute name="dotnetCommand" default="build"/>
		<attribute name="selfContainedArg" default="--self-contained"/>
		<sequential>
			<exec executable="dotnet" dir="." failonerror="true">
				<arg line=" restore --runtime @{runtime} -p:TargetFrameworks=@{targetVersion} -p:baseDir=@{baseDir} -p:IkvmVersion=@{IkvmVersion} -p:dllFileName=@{dllFileName} -p:CopyDependencies=@{copyDependencies} -p:VersionSuffix=@{version} -v @{verbose} @{baseDir}\proparse.csproj"/>
			</exec>
			<exec executable="dotnet" dir="." failonerror="true">
				<arg line=" clean --output @{output} --framework @{targetVersion} -p:TargetFrameworks=@{targetVersion} -p:baseDir=@{baseDir} -p:IkvmVersion=@{IkvmVersion} -p:dllFileName=@{dllFileName} -p:CopyDependencies=@{copyDependencies} -p:VersionSuffix=@{version} --runtime @{runtime} -v @{verbose} @{baseDir}\proparse.csproj"/>
			</exec>
			<exec executable="dotnet" dir="." failonerror="true">
				<arg line=" @{dotnetCommand} --output @{output} @{selfContainedArg} --framework @{targetVersion} -p:TargetFrameworks=@{targetVersion} -p:baseDir=@{baseDir} -p:IkvmVersion=@{IkvmVersion} -p:dllFileName=@{dllFileName} -p:CopyDependencies=@{copyDependencies} -p:VersionSuffix=@{version} --runtime @{runtime} -v @{verbose} @{baseDir}\proparse.csproj"/>
			</exec>
			<delete file="@{output}\proparse.dll"/>
			<delete file="@{output}\proparse.pdb"/>
            <delete dir="${basedir}\obj"/>
		</sequential>
	</macrodef>

	<target name="clean" description="Removes bin/, output/, obj/ and proparse.jar">
		<delete dir="${bin.dir}"/>
		<delete dir="${output.dir}"/>
		<delete dir="${basedir}/obj"/>
		<delete file="${basedir}/proparse.jar"/>
	</target>

	<!-- Compiles src/ into bin/. Eclipse does the same through its Java builder;
	     this target makes the build work from the command line without Eclipse. -->
	<target name="compile" description="Compiles the Java sources and copies resources into bin/">
		<!-- Always compile from scratch: token type numbers (ProParserTokenTypes, Last_Token_Number) are
		     compile time constants that javac inlines, so an incremental build leaves stale classes behind
		     whenever the token table changes. -->
		<delete dir="${bin.dir}"/>
		<mkdir dir="${bin.dir}"/>
		<javac srcdir="${src.dir}" destdir="${bin.dir}" release="${java.release}" encoding="UTF-8" debug="true" includeantruntime="false" nowarn="true">
			<classpath refid="build-classpath"/>
			<compilerarg value="-Xlint:none"/>
		</javac>
		<!-- token tables (*TokenTypes.txt), properties, icons and the test data used by the JUnit tests -->
		<copy todir="${bin.dir}">
			<fileset dir="${src.dir}" excludes="**/*.java,**/*.groovy"/>
		</copy>
	</target>

	<target name="makeproparsejar" depends="compile" description="Creates proparse.jar from bin/ and increments build.number">

		<tstamp/>
		<buildnumber/>

		<manifestclasspath property="lib.list" jarfile="proparse.jar">
		   <classpath refid="build-classpath" />
		</manifestclasspath>

		<jar jarfile="proparse.jar" >

			<manifest>
				<attribute name="Author" value="Joanju Software"/>
				<attribute name="Class-Path" value=". ${lib.list}"/>
				<section name="Proparse">
					<attribute name="Author" value="Joanju Software, Consultingwerk Software Services Ltd." />
					<attribute name="Home" value="joanju.com, oehive.org, github.com/consultingwerk/proparse"/>
					<attribute name="Build" value="${build.number}"/>
					<attribute name="Date" value="${TODAY}"/>
				</section>
				<section name="Copyright">
					<attribute name="Copy" value="(C) Joanju Software, Consultingwerk Software Services Ltd. 2002-2020"/>
					<attribute name="License" value="Eclipse Public License 2.0, and GNU Lesser General Public License v3.0"/>
				</section>
			</manifest>

			<zipfileset dir="bin" excludes="${core_xclds}" />

		</jar>
	</target>

	<!-- Java package for JVM consumers: proparse.jar, its lib/ dependencies and build.number, zipped as proparse.java/... -->
	<target name="make_java_package" depends="makeproparsejar" description="Creates output/proparse.java.zip with proparse.jar, lib/ and build.number">
		<mkdir dir="${output.dir}"/>
		<delete file="${package.zip.java}"/>
		<zip destfile="${package.zip.java}">
			<zipfileset file="${basedir}/proparse.jar" prefix="proparse.java"/>
			<zipfileset file="${basedir}/build.number" prefix="proparse.java"/>
			<zipfileset dir="${basedir}/lib" prefix="proparse.java/lib" includes="*.jar"/>
		</zip>
	</target>

	<target name="make_dotnet_msbuild" depends="make_java_package" description="Builds proparse.net.dll for net472/win-x64 and net8.0/linux-x64 via IKVM">
		<msbuild output="${output.dir.x64}" targetVersion="net472" runtime="win-x64"/>
		<delete file="${package.zip.win-x64}"/>
		<zip destfile="${package.zip.win-x64}">
			<zipfileset dir="${output.dir.x64}"/>
		</zip>
		<!-- 
		<msbuild output="${output.dir.x86}" targetVersion="net472" runtime="win-x86"/>
		<delete file="${package.zip.win-x86}"/>
		<zip destfile="${package.zip.win-x86}">
			<zipfileset dir="${output.dir.x86}"/>
		</zip>
		--> 
		<msbuild output="${output.dir.netcore}" targetVersion="net8.0" runtime="linux-x64" dotnetCommand="publish" selfContainedArg="" copyDependencies="true"/>
		<delete file="${package.zip.netcore}"/>
		<zip destfile="${package.zip.netcore}">
			<zipfileset dir="${output.dir.netcore}"/>
		</zip>
	</target>

	<!-- .NET 8 assemblies for Windows. Not part of the default target: run
	     "ant make_dotnet_netcore_win" after make_dotnet_msbuild; it reuses proparse.jar and build.number. -->
	<target name="make_dotnet_netcore_win" description="Builds proparse.net.dll for net8.0/win-x64 via IKVM into output/netcore-win-x64">
		<property file="${basedir}/build.number"/>
		<msbuild output="${output.dir.netcore.win}" targetVersion="net8.0" runtime="win-x64" dotnetCommand="publish" selfContainedArg="" copyDependencies="true"/>
		<delete file="${package.zip.netcore.win}"/>
		<zip destfile="${package.zip.netcore.win}">
			<zipfileset dir="${output.dir.netcore.win}"/>
		</zip>
	</target>

</project>
